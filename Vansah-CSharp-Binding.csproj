<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>Vansah_CSharp_Binding</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Keep any local-only test harness (localtests/, gitignored) out of the library build. -->
  <ItemGroup>
    <Compile Remove="localtests/**/*.cs" />
  </ItemGroup>

</Project>
